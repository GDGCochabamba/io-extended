---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Intro from "../components/Intro.astro";
import Schedule from "../components/Schedule.astro";
import Speakers from "../components/Speakers.astro";
import Venue from "../components/Venue.astro";
import Footer from "../components/Footer.astro";
import { isUpcoming, loadEventPage } from "../lib/event";

const slug = import.meta.env.PUBLIC_EVENT_SLUG ?? "io-extended-2025";
const { event, sessions, speakers } = await loadEventPage(slug);
const upcoming = isUpcoming(event);

// Before the event the main action is registering; afterwards, its page on gdg.community.dev.
const cta =
  upcoming && event.registrationUrl
    ? { label: "Inscríbete", href: event.registrationUrl }
    : event.externalUrl
      ? { label: "Ver detalle del evento", href: event.externalUrl }
      : undefined;
const headerCta = cta && {
  ...cta,
  label: cta.label === "Inscríbete" ? cta.label : "Ver detalle",
};
---

<Layout
  title={`${event.name} ${event.edition}`}
  description={event.description}
>
  <Header cta={headerCta} />
  <main>
    <Hero event={event} cta={cta} />
    <Intro event={event} sessions={sessions} />
    {sessions.length > 0 && <Schedule sessions={sessions} upcoming={upcoming} />}
    <Speakers speakers={speakers} />
    {event.venue && <Venue venue={event.venue} upcoming={upcoming} />}
  </main>
  <Footer year={event.edition} />
</Layout>
