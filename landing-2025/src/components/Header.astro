---
import { Image } from "astro:assets";
import lockup from "../assets/io25/lockup-io-extended.png";

interface Props {
  cta?: { label: string; href: string };
}
const { cta } = Astro.props;

const links = [
  { label: "Cronograma", href: "#cronograma" },
  { label: "Speakers", href: "#speakers" },
  { label: "Sede", href: "#sede" },
];
---

<header class="border-line sticky top-0 z-50 border-b bg-white/90 backdrop-blur">
  <nav
    class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6"
    aria-label="Principal"
  >
    <a
      href="#inicio"
      class="focus-visible:outline-io-blue flex shrink-0 items-center gap-3 rounded focus-visible:outline-2 focus-visible:outline-offset-4"
    >
      <Image
        src={lockup}
        alt="I/O Extended"
        height={26}
        densities={[1, 2]}
        class="h-[26px] w-auto"
      />
      <span class="text-muted hidden text-sm font-medium sm:inline">Cochabamba</span>
    </a>
    <div class="flex items-center gap-8">
      <ul class="hidden items-center gap-8 text-sm font-medium md:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="hover:text-io-blue focus-visible:outline-io-blue rounded transition-colors focus-visible:outline-2 focus-visible:outline-offset-4"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      {
        cta && (
          <a
            href={cta.href}
            target="_blank"
            rel="noopener noreferrer"
            class="io-pill focus-visible:outline-io-blue h-10 px-5 text-sm whitespace-nowrap focus-visible:outline-2 focus-visible:outline-offset-4"
          >
            {cta.label}
          </a>
        )
      }
    </div>
  </nav>
</header>
