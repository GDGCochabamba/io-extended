---
import { Image } from "astro:assets";
import { time, type Session } from "../lib/event";

interface Props {
  sessions: Session[];
  upcoming: boolean;
}
const { sessions, upcoming } = Astro.props;

const KIND = {
  talk: { label: "Charla", class: "bg-[#e8f0fe] text-[#1a56c4]" },
  workshop: { label: "Taller", class: "bg-[#e6f4ea] text-[#137333]" },
} as const;
---

<section id="cronograma" class="scroll-mt-16 px-6 py-16 md:py-24">
  <div class="mx-auto max-w-4xl">
    <h2
      class="io-heading-gradient pb-1 text-center text-4xl leading-tight font-bold md:text-6xl"
    >
      Cronograma del evento
    </h2>
    <p class="text-muted mt-4 text-center text-lg md:text-xl">
      {
        upcoming
          ? "Te presentamos las charlas y talleres que tendremos en el evento."
          : "Las charlas y talleres que tuvimos en el evento."
      }
    </p>

    <ol class="border-line divide-line mt-12 divide-y border-y">
      {
        sessions.map((session) => {
          const kind = KIND[session.type as keyof typeof KIND];
          if (!kind) {
            return (
              <li class="grid grid-cols-[4.5rem_1fr] gap-4 py-4 sm:grid-cols-[6rem_1fr]">
                <span class="text-muted font-mono text-sm">
                  {time(session.start)}
                </span>
                <p class="text-muted">{session.title}</p>
              </li>
            );
          }
          return (
            <li class="grid grid-cols-[4.5rem_1fr] gap-4 py-6 sm:grid-cols-[6rem_1fr]">
              <p class="font-mono text-sm leading-6">
                <time>{time(session.start)}</time>
                <span class="text-muted block">{time(session.end)}</span>
              </p>
              <div>
                <span
                  class={`inline-block rounded-full px-3 py-0.5 text-xs font-medium ${kind.class}`}
                >
                  {kind.label}
                </span>
                <h3 class="mt-2 text-lg leading-snug font-medium md:text-xl">
                  {session.title}
                </h3>
                {session.speakers.length > 0 && (
                  <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
                    {session.speakers.map((speaker) => (
                      <li class="text-muted flex items-center gap-2 text-sm">
                        {speaker.photoUrl && (
                          <Image
                            src={speaker.photoUrl}
                            alt=""
                            width={32}
                            height={32}
                            densities={[1, 2]}
                            class="size-8 rounded-full object-cover"
                          />
                        )}
                        {speaker.name}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
