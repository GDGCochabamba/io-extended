---
import { Image } from "astro:assets";
import type { Speaker } from "../lib/event";

interface Props {
  speakers: Speaker[];
}
const { speakers } = Astro.props;

const SOCIAL_LABELS: Record<string, string> = {
  linkedin: "LinkedIn",
  twitter: "X",
  github: "GitHub",
  instagram: "Instagram",
  youtube: "YouTube",
  facebook: "Facebook",
  web: "Web",
};

// Firestore doesn't keep the order of map keys, so list the links in the order
// of SOCIAL_LABELS (LinkedIn first) and unknown ones last.
const rank = (type: string) => {
  const i = Object.keys(SOCIAL_LABELS).indexOf(type);
  return i === -1 ? Infinity : i;
};
const sortedSocials = (socials: Record<string, string>) =>
  Object.entries(socials).sort(([a], [b]) => rank(a) - rank(b));

const initials = (name: string) =>
  name
    .split(/\s+/)
    .slice(0, 2)
    .map((w) => w[0])
    .join("")
    .toUpperCase();
---

{
  speakers.length > 0 && (
    <section id="speakers" class="io-grid scroll-mt-16 px-6 py-16 md:py-24">
      <h2 class="io-heading-gradient pb-1 text-center text-4xl leading-tight font-bold md:text-6xl">
        Speakers
      </h2>
      <ul class="mx-auto mt-12 grid max-w-6xl gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {speakers.map((speaker) => (
          <li class="border-line flex flex-col rounded-3xl border bg-white p-4">
            {speaker.photoUrl ? (
              <Image
                src={speaker.photoUrl}
                alt={speaker.name}
                width={480}
                height={480}
                class="aspect-square w-full rounded-2xl object-cover"
              />
            ) : (
              <div
                class="from-io-blue to-io-violet flex aspect-square w-full items-center justify-center rounded-2xl bg-linear-to-br text-5xl font-bold text-white"
                aria-hidden="true"
              >
                {initials(speaker.name)}
              </div>
            )}
            <div class="flex flex-1 flex-col px-1 pt-4 pb-1">
              <h3 class="text-lg leading-snug font-medium">{speaker.name}</h3>
              {speaker.talkTitle && (
                <p class="text-muted mt-1 line-clamp-3 text-sm leading-relaxed">
                  {speaker.talkTitle}
                </p>
              )}
              {Object.keys(speaker.socials).length > 0 && (
                <ul class="mt-auto flex flex-wrap gap-2 pt-4 text-xs">
                  {sortedSocials(speaker.socials).map(([type, url]) => (
                    <li>
                      <a
                        href={url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="border-line hover:border-io-blue hover:text-io-blue focus-visible:outline-io-blue block rounded-full border px-3 py-1 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
                      >
                        {SOCIAL_LABELS[type] ?? type}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
